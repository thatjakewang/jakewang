{
  "name": "main-site-assets",
  "private": true,
  "scripts": {
    "build": "npm run build:scripts && npm run build:styles",
    "build:scripts": "esbuild frontend/js/dashboard.js frontend/js/tesla.js frontend/js/nav.js --minify --outdir=static/js --outbase=frontend/js --out-extension:.js=.min.js",
    "build:styles": "esbuild frontend/css/style.css --minify --outfile=static/css/style.min.css"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
